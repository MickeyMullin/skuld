<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.mickey.skuld</string>
  <key>ProgramArguments</key>
  <array>
    <string>__BUN__</string>
    <string>run</string>
    <string>--cwd</string>
    <string>__HOME__/app/skuld/server</string>
    <string>src/index.ts</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__HOME__/app/skuld</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__HOME__/.bun/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>SKULD_HOST</key>
    <string>127.0.0.1</string>
    <key>SKULD_PORT</key>
    <string>3456</string>
    <key>SKULD_DB</key>
    <string>__HOME__/app/skuld/server/skuld.db</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__HOME__/app/skuld/skuld.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/app/skuld/skuld.err.log</string>
</dict>
</plist>
